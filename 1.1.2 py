import math

n = int(input())

# Check number of digits
if 1 <= n <= 9:
    # Single digit → square
    print(n ** 2)

elif 10 <= n <= 99:
    # Two digits → square root (2 decimal places)
    print(f"{math.sqrt(n):.2f}")

elif 100 <= n <= 999:
    # Three digits → cube root (2 decimal places)
    print(f"{n ** (1/3):.2f}")

else:
    print("Invalid")
